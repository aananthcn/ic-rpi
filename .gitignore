.ninja_deps
.ninja_log
build.ninja

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.python-version

# ── Logs & temp files ─────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*~

